# Public Base Mainnet deployment. No platform secrets or signer keys belong here.
VITE_NETWORK=base
# Options: USDC, EURC, WETH, ETH; this deployment enables USDC and ETH only.
VITE_ENABLED_SETTLEMENT_ASSETS=USDC,ETH
VITE_USDC_FACTORY_ADDRESS=0x1818Ab2d2F09A3606777d3562357440d969D3323
VITE_ETH_FACTORY_ADDRESS=0x70d6Dc49d57Ba9e6767F0B2De0B1Fcc86699E21A
VITE_ETH_ADDRESS_MODE=shared
# Set YOUR operator wallet; ordinary operators activate onchain through the frontend.
VITE_OPERATOR_ADDRESS=
VITE_OPERATOR_TELEGRAM_BOT=Cryptobattle2OperatorBot
# Optional customer bot: its OWN token, no Mini App. Needs the bet API enabled.
VITE_CUSTOMER_TELEGRAM_BOT=
CUSTOMER_TELEGRAM_BOT_TOKEN=
CUSTOMER_FRONTEND_URL=
CUSTOMER_BOT_POLL_INTERVAL_MS=60000
CUSTOMER_BOT_MAX_USERS=1000
CUSTOMER_BOT_MAX_CHECKS_PER_POLL=20
# Set COMPOSE_PROFILES=customer and ENDUSER_BET_API_ENABLED=true below to enable it.
# Browser-visible RPCs; use a separate domain-restricted provider key if desired.
VITE_RPC_URLS=https://mainnet.base.org
# Optional private server-only RPC endpoints, comma separated.
OPERATOR_API_RPC_URLS=
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
ENDUSER_BET_API_ENABLED=false
OPERATOR_API_ALLOWED_ORIGINS=
COMPOSE_PROFILES=
# Optional fee monitor: use your OWN token; never poll the central group token.
OPERATOR_BOT_RPC_URLS=
OPERATOR_TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_ALLOWED_CHAT_IDS=
OPERATOR_TELEGRAM_POLLING_ENABLED=true
OPERATOR_TELEGRAM_REPORT_MODE=each
