FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts && npm cache clean --force
COPY . .
ARG VITE_NETWORK=baseSepolia
ARG VITE_USDC_FACTORY_ADDRESS
ARG VITE_EURC_FACTORY_ADDRESS
ARG VITE_WETH_FACTORY_ADDRESS
ARG VITE_ETH_FACTORY_ADDRESS
ARG VITE_ETH_ADDRESS_MODE=shared
ARG VITE_ENABLED_SETTLEMENT_ASSETS=USDC,EURC,WETH,ETH
ARG VITE_OPERATOR_ADDRESS
ARG VITE_OPERATOR_TELEGRAM_BOT
ARG VITE_CUSTOMER_TELEGRAM_BOT
ARG VITE_MARKET_API_URL
ARG VITE_RPC_URL
ARG VITE_RPC_URLS
ARG VITE_SWAPPER_ENABLED=true
ARG VITE_SWAPPER_API_URL
ARG VITE_SWAPPER_OPERATOR_ID
ARG VITE_SWAP_DISTRIBUTOR_ADDRESS
ARG VITE_SWAP_NETWORK=base
ARG VITE_SWAP_RPC_URLS
ENV VITE_NETWORK=$VITE_NETWORK VITE_USDC_FACTORY_ADDRESS=$VITE_USDC_FACTORY_ADDRESS VITE_EURC_FACTORY_ADDRESS=$VITE_EURC_FACTORY_ADDRESS VITE_WETH_FACTORY_ADDRESS=$VITE_WETH_FACTORY_ADDRESS VITE_ETH_FACTORY_ADDRESS=$VITE_ETH_FACTORY_ADDRESS VITE_ETH_ADDRESS_MODE=$VITE_ETH_ADDRESS_MODE VITE_ENABLED_SETTLEMENT_ASSETS=$VITE_ENABLED_SETTLEMENT_ASSETS VITE_OPERATOR_ADDRESS=$VITE_OPERATOR_ADDRESS VITE_MARKET_API_URL=$VITE_MARKET_API_URL VITE_RPC_URL=$VITE_RPC_URL VITE_RPC_URLS=$VITE_RPC_URLS VITE_SWAPPER_ENABLED=$VITE_SWAPPER_ENABLED VITE_SWAPPER_API_URL=$VITE_SWAPPER_API_URL VITE_SWAPPER_OPERATOR_ID=$VITE_SWAPPER_OPERATOR_ID VITE_SWAP_DISTRIBUTOR_ADDRESS=$VITE_SWAP_DISTRIBUTOR_ADDRESS VITE_SWAP_NETWORK=$VITE_SWAP_NETWORK VITE_SWAP_RPC_URLS=$VITE_SWAP_RPC_URLS
ENV VITE_OPERATOR_TELEGRAM_BOT=$VITE_OPERATOR_TELEGRAM_BOT
ENV VITE_CUSTOMER_TELEGRAM_BOT=$VITE_CUSTOMER_TELEGRAM_BOT
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN apk add --no-cache nodejs
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/runtime-config.mjs /opt/cryptobattle/runtime-config.mjs
COPY docker/operator-api.mjs /opt/cryptobattle/operator-api.mjs
COPY docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN chmod 755 /docker-entrypoint.d/40-runtime-config.sh
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

FROM runtime AS operator
ENV CRYPTOBATTLE_STANDALONE=true
COPY nginx.operator.conf /etc/nginx/conf.d/default.conf

FROM runtime AS frontend
